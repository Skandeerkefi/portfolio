---

<section id="contact" class="section bg-gray-900">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="animate-on-scroll">
      <h2 class="section-title">
        <span class="text-gradient">Get In Touch</span>
      </h2>
      <p class="section-subtitle">
        Have a project in mind or want to collaborate? Let's connect!
      </p>
    </div>

    <!-- Single clean card -->
    <div class="max-w-3xl mx-auto animate-on-scroll">
      <div class="card">
        <div class="flex items-center justify-between gap-6 flex-wrap mb-6">
          <h3 class="text-2xl font-bold text-white">Contact</h3>

          <div class="flex gap-3">
            {socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-11 h-11 rounded-lg bg-gray-900 border border-gray-700 flex items-center justify-center text-gray-400 hover:text-primary-400 hover:border-primary-600 transition-all duration-300"
                aria-label={social.name}
                title={social.name}
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d={social.icon} />
                </svg>
              </a>
            ))}
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <!-- Email -->
          <a
            class="flex items-start gap-4 p-4 rounded-xl bg-gray-900/40 border border-gray-800 hover:border-primary-600/60 transition-colors"
            href={`mailto:${contactInfo.email}`}
          >
            <div class="w-10 h-10 rounded-lg bg-primary-600/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-18 10h18a2 2 0 002-2V8a2 2 0 00-2-2H3a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-gray-400 text-sm">Email</p>
              <p class="text-white font-medium break-all">{contactInfo.email}</p>
            </div>
          </a>

          <!-- Phone -->
          <a
            class="flex items-start gap-4 p-4 rounded-xl bg-gray-900/40 border border-gray-800 hover:border-primary-600/60 transition-colors"
            href={`tel:${contactInfo.phone}`}
          >
            <div class="w-10 h-10 rounded-lg bg-primary-600/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.128a11.042 11.042 0 005.516 5.516l1.128-2.257a1 1 0 011.21-.502l4.493 1.498A1 1 0 0121 15.72V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-gray-400 text-sm">Phone</p>
              <p class="text-white font-medium">{contactInfo.phone}</p>
            </div>
          </a>

          <!-- Location -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-gray-900/40 border border-gray-800">
            <div class="w-10 h-10 rounded-lg bg-primary-600/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-gray-400 text-sm">Location</p>
              <p class="text-white font-medium">{contactInfo.location}</p>
            </div>
          </div>

          <!-- Availability -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-gray-900/40 border border-gray-800">
            <div class="w-10 h-10 rounded-lg bg-primary-600/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-gray-400 text-sm">Availability</p>
              <p class="text-white font-medium">{contactInfo.availability}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>