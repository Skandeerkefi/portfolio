---

<section id="home" class="min-h-screen flex items-center section pt-24 bg-black">
  <div class="container-custom">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-8 animate-on-scroll">
        <p class="inline-flex items-center px-4 py-2 rounded-full border border-gray-600 bg-black text-white text-sm md:text-base mb-6">
          Fullstack JavaScript Developer
        </p>

        <h1 class="text-5xl md:text-7xl font-bold mb-5 leading-tight">
          Hi, I'm <span class="text-gradient">Skander Kefi</span>
        </h1>

        <p class="text-lg md:text-2xl text-gray-200 mb-10 max-w-3xl leading-relaxed">
          I build fast, scalable web products with clean code, clear UX, and reliable backend architecture.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a href="#projects" class="btn-primary">View My Work</a>
          <a href="#contact" class="btn-secondary">Get In Touch</a>
        </div>

        <div class="flex items-center gap-4">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-xl border border-gray-600 bg-black text-gray-200 hover:text-white hover:border-white transition-all duration-300 flex items-center justify-center"
              aria-label={social.name}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <div class="lg:col-span-4 animate-on-scroll">
        <div class="card p-8 space-y-6">
          <div>
            <p class="text-gray-200 text-sm uppercase tracking-widest mb-2">Focus</p>
            <p class="text-white text-xl font-semibold">Modern Web Apps</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-gray-700 bg-black p-4">
              <p class="text-2xl font-bold text-white">2+</p>
              <p class="text-gray-200 text-sm">Years Building</p>
            </div>
            <div class="rounded-lg border border-gray-700 bg-black p-4">
              <p class="text-2xl font-bold text-white">8+</p>
              <p class="text-gray-200 text-sm">Live Projects</p>
            </div>
          </div>
          <p class="text-gray-200 text-sm leading-relaxed">
            React, Next.js, Node.js, and Tailwind — delivered with performance and maintainability in mind.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-14 flex justify-center animate-bounce">
      <a href="#experience" aria-label="Scroll to experience section">
        <svg
          class="w-6 h-6 text-gray-300"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"
          />
        </svg>
      </a>
    </div>
  </div>
</section>
