---
// Experience data - CUSTOMIZE THIS with your real experience
const experiences = [
  {
    title: 'Senior Fullstack Developer',
    company: 'Tech Innovations Inc.',
    period: 'Jan 2023 - Present',
    description: 'Led development of enterprise-level web applications using React, Node.js, and cloud services. Mentored junior developers and implemented best practices for scalable architecture.',
    technologies: ['React', 'Node.js', 'TypeScript', 'AWS', 'PostgreSQL', 'Docker']
  },
  {
    title: 'Fullstack JavaScript Developer',
    company: 'Digital Solutions Co.',
    period: 'Mar 2021 - Dec 2022',
    description: 'Built and maintained multiple client-facing applications. Collaborated with cross-functional teams to deliver high-quality software solutions on time.',
    technologies: ['Next.js', 'Express', 'MongoDB', 'Redis', 'GraphQL', 'Tailwind CSS']
  },
  {
    title: 'Frontend Developer',
    company: 'StartUp Hub',
    period: 'Jun 2019 - Feb 2021',
    description: 'Developed responsive and performant user interfaces. Worked closely with designers to transform mockups into pixel-perfect implementations.',
    technologies: ['Vue.js', 'JavaScript', 'SASS', 'Webpack', 'Jest', 'Cypress']
  }
];
---

<section id="experience" class="section bg-gray-900">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="animate-on-scroll">
      <h2 class="section-title">
        <span class="text-gradient">Experience</span>
      </h2>
      <p class="section-subtitle">
        My professional journey in software development
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical Line -->
      <div class="hidden md:block absolute left-1/2 transform -translate-x-1/2 h-full w-0.5 bg-gradient-to-b from-primary-600 to-transparent"></div>

      <!-- Experience Items -->
      <div class="space-y-12">
        {experiences.map((exp, index) => (
          <div class={`animate-on-scroll relative ${index % 2 === 0 ? 'md:pr-1/2' : 'md:pl-1/2'}`}>
            <div class={`card ${index % 2 === 0 ? 'md:mr-8' : 'md:ml-8'}`}>
              <!-- Timeline Dot -->
              <div class="hidden md:block absolute top-8 w-4 h-4 bg-primary-600 rounded-full border-4 border-gray-900"
                   style={`${index % 2 === 0 ? 'right: -2.5rem' : 'left: -2.5rem'}`}>
              </div>

              <!-- Content -->
              <div class="mb-4">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-2">
                  <h3 class="text-2xl font-bold text-white">{exp.title}</h3>
                  <span class="text-primary-400 font-semibold">{exp.period}</span>
                </div>
                <p class="text-xl text-gray-300 font-medium">{exp.company}</p>
              </div>

              <p class="text-gray-400 mb-4 leading-relaxed">
                {exp.description}
              </p>

              <!-- Technologies -->
              <div class="flex flex-wrap gap-2">
                {exp.technologies.map((tech) => (
                  <span class="px-3 py-1 bg-gray-900 text-primary-400 rounded-full text-sm font-medium border border-gray-700">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .md\:pr-1\/2 {
      padding-right: 50%;
    }
    .md\:pl-1\/2 {
      padding-left: 50%;
    }
  }
</style>
