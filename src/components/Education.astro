---
// Education data - CUSTOMIZE THIS with your real education
const education = [
  {
    degree: "Research Master's in Information Systems and Web",
    institution: 'Higher Institute of Computer Science of Kef',
    period: '2024 - Present',
    description:
      "Currently pursuing a research master's program focused on information systems and web technologies.",
    achievements: []
  },
  {
    degree: 'Bachelor in Computer Science',
    institution: 'Higher Institute of Computer Science of Kef',
    period: '2021 - 2024',
    description:
      'Completed a bachelor’s degree in computer science, covering core topics such as software development, databases, algorithms.',
    achievements: []
  },
  {
    degree: 'Baccalaureate in Science',
    institution: 'Chartage Présidence',
    period: '2021',
    description:
      'Completed the Tunisian baccalaureate in science with a strong foundation in mathematics and physics.',
    achievements: []
  }
];
---

<section id="education" class="section bg-gray-800">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="animate-on-scroll">
      <h2 class="section-title">
        <span class="text-gradient">Education</span>
      </h2>
      <p class="section-subtitle">
        My academic background and continuous learning journey
      </p>
    </div>

    <!-- Education Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {education.map((edu) => (
        <div class="card animate-on-scroll">
          <!-- Header -->
          <div class="mb-4">
            <div class="flex items-start justify-between mb-2">
              <div class="flex-1">
                <h3 class="text-xl font-bold text-white mb-1">
                  {edu.degree}
                </h3>
                <p class="text-primary-400 font-semibold">
                  {edu.institution}
                </p>
              </div>
            </div>
            <span class="text-gray-400 text-sm">{edu.period}</span>
          </div>

          <!-- Description -->
          <p class="text-gray-400 mb-4 leading-relaxed text-sm">
            {edu.description}
          </p>

          <!-- Achievements -->
          <div class="space-y-2">
            {edu.achievements.map((achievement) => (
              <div class="flex items-start gap-2">
                <svg
                  class="w-5 h-5 text-primary-400 flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <span class="text-gray-300 text-sm">{achievement}</span>
              </div>
            ))}
          </div>

          <!-- Icon -->
          <div class="mt-6 pt-6 border-t border-gray-700">
            <svg
              class="w-10 h-10 text-primary-600 opacity-50"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 14l9-5-9-5-9 5 9 5z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"
              />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
